{
  "name": "paper-notes",
  "version": "2.0.1",
  "private": true,
  "license": "MIT",
  "description": "A local research workspace for reading PDFs, annotating papers, and building HTML notes with an AI assistant.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview",
    "start": "uv run python main.py",
    "test": "uv run --group dev pytest",
    "test:e2e": "playwright test",
    "lint": "uv run --group dev ruff check src tests"
  },
  "dependencies": {
    "katex": "^0.16.46",
    "lucide-react": "^1.18.0",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
