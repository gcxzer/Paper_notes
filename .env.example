# Paper Notes local server
HOST=127.0.0.1
PORT=4173
PAPER_NOTES_MAX_BODY_SIZE=209715200

# AWS credentials are not stored here.
# Configure this profile with `aws configure sso` or your normal AWS CLI credential flow.
AWS_PROFILE=your-profile
AWS_REGION=your-region

# Paper Notes ownership/metadata
PAPER_NOTES_OWNER_ID=personal
PAPER_NOTES_METADATA_TABLE=your-metadata-table

# Storage bucket used for source PDFs, notes, annotations, and KB documents.
PAPER_NOTES_BUCKET=your-paper-notes-bucket

# Bedrock Knowledge Base resources.
PAPER_NOTES_KNOWLEDGE_BASE_ID=your-knowledge-base-id
PAPER_NOTES_KB_DATA_SOURCE_ID=your-kb-data-source-id
PAPER_NOTES_KB_NUMBER_OF_RESULTS=5

# Chat defaults to AgentCore Harness. The Harness should use a Gateway target
# that points to the Paper Notes MCP server hosted on AgentCore Runtime.
PAPER_NOTES_CHAT_BACKEND=agentcore
PAPER_NOTES_AGENTCORE_HARNESS_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:harness/Harness-Name
# Optional but recommended when Harness Memory is attached. This scopes long-term
# memory to one user/entity while runtimeSessionId scopes an individual chat.
PAPER_NOTES_MEMORY_ACTOR_ID=your-user-id
# Optional. The helper script can infer this from the Harness after Memory is
# attached; set it only when you want to attach IAM policy to a specific Memory.
PAPER_NOTES_MEMORY_ARN=
PAPER_NOTES_AGENTCORE_GATEWAY_ID=your-gateway-id
# Optional. If omitted, the server derives it from the Gateway ID and Harness ARN.
PAPER_NOTES_AGENTCORE_GATEWAY_ARN=
PAPER_NOTES_AGENTCORE_MCP_RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/paper-notes-mcp-runtime
PAPER_NOTES_AGENTCORE_RUNTIME_QUALIFIER=DEFAULT
PAPER_NOTES_GATEWAY_TARGET_NAME=paper-notes-mcp

# Optional public web search tool exposed by the same MCP server.
# Set TAVILY_API_KEY or BRAVE_SEARCH_API_KEY. If both are set, Tavily is used.
PAPER_NOTES_WEB_SEARCH_MAX_RESULTS=5
PAPER_NOTES_TAVILY_SEARCH_DEPTH=basic
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional fallback only. Set PAPER_NOTES_CHAT_BACKEND=knowledge-base if you want
# /api/chat to bypass Harness and call Bedrock Knowledge Base directly.
PAPER_NOTES_GENERATION_MODEL_ARN=arn:aws:bedrock:REGION:ACCOUNT_ID:inference-profile/YOUR_MODEL_PROFILE

# Set to 1 for local-only mode. Importing PDFs will skip S3, DynamoDB, and KB sync.
PAPER_NOTES_DISABLE_CLOUD_SYNC=0
