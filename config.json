{
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "title": "Paper Notes",
    "docs_url": "/docs"
  },
  "tool_output": {
    "enabled": true,
    "root_dir": ".paper-notes/tool-outputs",
    "default_max_tokens": 8000,
    "placeholder_keep_recent": 8,
    "tool_limits": {
      "search_notes": 4000,
      "get_note_context": 10000,
      "read_paper": 12000,
      "search_paper_rag": 10000,
      "write_note": 6000,
      "manage_annotations": 6000,
      "write_note_media": 6000,
      "review_note": 8000,
      "skills_list": 8000,
      "skill_view": 12000
    }
  },
  "rag": {
    "root_dir": ".paper-notes/rag",
    "index_root": ".paper-notes/rag/indexes",
    "image_root": ".paper-notes/rag/images",
    "collections": {
      "text": "paper_notes"
    },
    "build": {
      "loader": "llamaparse",
      "include_images": true,
      "qdrant": true,
      "bm25": true
    },
    "llamaparse": {
      "tier": "agentic",
      "version": "2026-06-04",
      "timeout": 7200,
      "polling_interval": 2,
      "max_interval": 20,
      "image_download_timeout": 60,
      "image_categories": ["embedded", "layout"],
      "ocr_languages": [],
      "custom_prompt": "Parse this academic paper into clean Markdown. Preserve section headings, equations, citations, figure captions, table captions, tables, and references. Keep the reading order correct for multi-column paper layouts."
    },
    "chunking": {
      "chunk_size": 800,
      "chunk_overlap": 120
    },
    "image_captioning": {
      "enabled": true,
      "provider": "codex-oauth",
      "model": "gpt-5.4-mini",
      "max_images": 100,
      "max_image_bytes": 8388608,
      "timeout": 120,
      "prompt": "Describe this academic-paper image for retrieval. Include visible labels, axes, legends, table fields, equations, entities, and the main relationship or result. Be concise, factual, and use plain text only. If details are unreadable, say what is visible instead of guessing."
    },
    "embedding": {
      "provider": "openai",
      "model": "qwen3-embedding:8b",
      "batch_size": 100,
      "openai": {
        "model": "Qwen/Qwen3-Embedding-8B",
        "api_base_env": "MODELSCOPE_BASEURL",
        "api_key_env": "MODELSCOPE_TOKEN"
      }
    },
    "retrieval": {
      "similarity_top_k": 5,
      "bm25_similarity_top_k": 5,
      "hybrid_weights": [0.7, 0.3]
    }
  }
}
